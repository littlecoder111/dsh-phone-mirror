{
  "name": "dsh-phone-mirror",
  "version": "0.1.0",
  "description": "Mirror and control a USB-connected Android phone from the DeepSeek Harness right sidebar, with agent tools for touch, keys, text and file transfer.",
  "type": "module",
  "license": "MIT",
  "author": "littlecoder111",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/littlecoder111/dsh-phone-mirror.git"
  },
  "homepage": "https://github.com/littlecoder111/dsh-phone-mirror#readme",
  "bugs": {
    "url": "https://github.com/littlecoder111/dsh-phone-mirror/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "scrcpy",
    "android",
    "screen-mirror",
    "adb"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "resources/*",
    "LICENSE",
    "LICENSES/*",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
